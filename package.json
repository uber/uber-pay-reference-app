{
  "name": "uberpay-psp-reference", "version": "2.0.0", "private": true,
  "description": "Native Node.js, Java and Go PSP reference gateways with shared wire conformance tests; synthetic funds only",
  "license": "Apache-2.0",
  "scripts": {
    "build": "npm --prefix implementations/node run build",
    "start": "node implementations/node/dist/main.js",
    "test": ".venv/bin/python -m unittest discover -s conformance/tests -v",
    "test:all": "make verify",
    "test:e2e": ".venv/bin/python -m conformance.run",
    "contract:check": ".venv/bin/python tools/check_contract.py"
  }
}
