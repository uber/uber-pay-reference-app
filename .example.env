# SYNTHETIC LOCAL DEMO ONLY. Do not put real PSP/Uber credentials here.
MODE=local
BASE_PATH=/uberpay/v1
CLIENT_ID=demo-client
CLIENT_SECRET=demo-secret
UBER_CLIENT_ID=demo-uber-client
UBER_CLIENT_SECRET=demo-uber-secret
UBER_KEY_ID=demo-uber-key
ALLOWED_REDIRECT_URIS=http://127.0.0.1:9090/return,uber://ubercash_topup
OAUTH_REQUIRED=false
SIGNATURE_MAX_SKEW_SECONDS=300
ASYNC_DELAY_MS=500
WORKER_INTERVAL_MS=100
CALLBACK_RETRY_MS=200
CALLBACK_MAX_ATTEMPTS=5
# Controls are disabled for the default demo, enabled with random secrets by tests.
ENABLE_TEST_CONTROL=false
TEST_CONTROL_SECRET=
